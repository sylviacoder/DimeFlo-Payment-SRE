# Terraform: state and variable files can contain secrets. Never commit them.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
.terraform.tfstate.lock.info

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig*

# Node / Python
node_modules/
dist/
__pycache__/
*.pyc
.venv/

# Load test and chaos output
chaos/results/
*.k6.json

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
